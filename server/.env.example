# Copy to .env and run `npm run dev` (Node >= 22.9 loads it via --env-file-if-exists).
# `npm start` / Render read real environment variables only.

# development | test | production
NODE_ENV=development

# Port for HTTP + Socket.IO. Render injects its own PORT.
PORT=4000

# Comma-separated browser origins allowed by CORS, or * for any.
# Unset in development  -> http://localhost:3000, http://127.0.0.1:3000
# Unset in production   -> * (previous behaviour) plus a startup warning
# CORS_ORIGINS=https://your-frontend.onrender.com
