# Copy to .env.local for local overrides (Create React App loads it automatically).
# Values are baked into the bundle at build time - never put secrets here.

# URL of the backend (Express + Socket.IO).
# Local default when unset: http://127.0.0.1:4000
# On Render, set this on the frontend service to the backend's public URL.
REACT_APP_BACKEND_URL=http://127.0.0.1:4000
